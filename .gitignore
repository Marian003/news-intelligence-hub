# Dependencies
node_modules/

# Build output
dist/
build/
*.tsbuildinfo

# Local environment — secrets live here, never committed
.env
# Any per-environment variant (.env.local, .env.production, ...). The negation
# keeps the committed template tracked - without it, .env.* would swallow the
# one file in this family that MUST stay in git.
.env.*
!.env.example
*.local
# Rendered Kubernetes Secret (contains real keys) — only the example is tracked
k8s/secret.yaml

# Logs
*.log
logs/

# Test / coverage artifacts
coverage/

# Editor / OS noise
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Claude Code local harness state (personal permission grants, not project config)
.claude/
config.bat
