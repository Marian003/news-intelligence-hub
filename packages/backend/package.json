{
  "name": "@nih/backend",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/main.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "start:bullboard": "node dist/bullboard.js",
    "clean": "tsc -b --clean",
    "drizzle:generate": "drizzle-kit generate",
    "migrate": "node dist/database/migrate.js",
    "seed": "node dist/database/seed.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@bull-board/api": "^7.1.5",
    "@bull-board/express": "^7.1.5",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.15",
    "@nih/shared": "workspace:*",
    "@node-rs/argon2": "^2.0.2",
    "bullmq": "^5.77.6",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.8.0",
    "ioredis": "^5.4.2",
    "pg": "^8.13.1",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.31.10",
    "vitest": "^4.1.7"
  }
}
