{
  "name": "news-intelligence-hub",
  "version": "0.0.0",
  "private": true,
  "description": "Multi-user app that turns RSS/Atom feeds into a per-user entity relationship graph.",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "lint": "gts lint && node scripts/check-unicode.mjs",
    "lint:unicode": "node scripts/check-unicode.mjs",
    "fix": "gts fix",
    "build": "pnpm -r build",
    "test": "pnpm -r --if-present test",
    "clean": "gts clean && pnpm -r clean",
    "up": "docker compose up --build",
    "down": "docker compose down"
  },
  "devDependencies": {
    "gts": "^5.3.1",
    "typescript": "~5.5.4"
  }
}
