# Copy this file to `.env` and fill in real values. The `.env` file is git-ignored
# and is the ONLY place secrets live. Every variable the stack reads is listed here.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# development | production — controls dev-only behaviour (e.g. printing the
# email-confirmation link to the log instead of sending real mail).
NODE_ENV=development
# Port the NestJS backend listens on.
BACKEND_PORT=3000
# Public origin of the FRONTEND, used to build links shown to users (e.g. the
# dev-mode email confirmation link points at the SPA's /confirm route).
APP_PUBLIC_URL=http://localhost:8080

# ---------------------------------------------------------------------------
# PostgreSQL — primary data store.
# ---------------------------------------------------------------------------
# Host + port the backend connects to. Inside docker compose this is the service
# name and the in-container port (5432); they do not change with the host port.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=news_hub
POSTGRES_USER=news_hub
# No default — set a real password.
POSTGRES_PASSWORD=
# Port published to your machine for inspection (psql, GUIs). Change it if 5432
# is already taken locally; this does not affect the in-cluster connection above.
POSTGRES_HOST_PORT=5432

# ---------------------------------------------------------------------------
# Redis — BullMQ broker for all background jobs.
# ---------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
# Host-published port; change if 6379 is already in use locally.
REDIS_HOST_PORT=6379

# ---------------------------------------------------------------------------
# Auth — JWT signing.
# ---------------------------------------------------------------------------
# Long random string. No default — generate one (e.g. `openssl rand -hex 32`).
JWT_SECRET=
# Access-token lifetime, e.g. 15m, 1h, 7d.
JWT_EXPIRES_IN=1h

# ---------------------------------------------------------------------------
# LLM — provider-independent abstraction. Pick the active provider here; the
# matching adapter reads its own key + model below.
# ---------------------------------------------------------------------------
# openai | anthropic
LLM_PROVIDER=anthropic
# Hard ceiling on tokens per article analysis (cost control).
LLM_MAX_TOKENS=1024
# Per-call timeout in milliseconds.
LLM_TIMEOUT_MS=30000
# Retry attempts before failing over / marking the article for later.
LLM_MAX_RETRIES=2

# OpenAI adapter
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Override only for a proxy / Azure / a local mock; defaults to the public API.
OPENAI_BASE_URL=https://api.openai.com

# Anthropic adapter
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_BASE_URL=https://api.anthropic.com

# ---------------------------------------------------------------------------
# Deterministic pre-filter — articles below these thresholds never reach the LLM.
# ---------------------------------------------------------------------------
PREFILTER_MIN_CHARS=200
PREFILTER_MIN_WORDS=40

# ---------------------------------------------------------------------------
# Workers / scheduling.
# ---------------------------------------------------------------------------
# Cron expression for the scheduled feed poll.
FEED_POLL_CRON=*/15 * * * *
# Abort a feed HTTP fetch after this many milliseconds.
FEED_FETCH_TIMEOUT_MS=15000
# How many jobs a worker handles in parallel.
WORKER_CONCURRENCY=2

# ---------------------------------------------------------------------------
# Bull Board — queue dashboard, served standalone behind basic-auth.
# ---------------------------------------------------------------------------
BULLBOARD_PORT=3100
BULLBOARD_USER=admin
# No default — set a real password.
BULLBOARD_PASSWORD=

# ---------------------------------------------------------------------------
# Frontend (Vite SPA).
# ---------------------------------------------------------------------------
# Where the browser reaches the backend API (baked into the build).
VITE_API_URL=http://localhost:3000
# Host port the frontend is served on.
FRONTEND_PORT=8080
